#!/bin/sh
# 发布棘轮：推 tag 之前必须过闸门（scripts/release-check.py）。
#
# 为什么在 hook 里做：记住"先测再发"是靠不住的，机器拦一次最省心。
# 推普通分支不跑（太慢，也有 CI 兜着）。
#
# 装一次就生效：scripts/install-hooks.ps1（或 git config core.hooksPath .githooks）

tag_pushed=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/tags/*) tag_pushed=1 ;;
  esac
done

if [ "$tag_pushed" = "1" ]; then
  echo "== 检测到 tag 推送：跑发布前闸门 =="
  if command -v python >/dev/null 2>&1; then
    PY=python
  elif command -v python3 >/dev/null 2>&1; then
    PY=python3
  elif command -v py >/dev/null 2>&1; then
    PY="py -3"
  else
    echo "✗ 找不到 python，闸门没跑 → 拒绝推送 tag"
    exit 1
  fi
  if ! $PY scripts/release-check.py; then
    echo ""
    echo "✗ 闸门没过，tag 没推出去。修完再推，别用 --no-verify 绕。"
    exit 1
  fi
fi

exit 0
